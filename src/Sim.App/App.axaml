          <SolidColorBrush x:Key="RailBrush" Color="#F5EEF2F6" />
          <SolidColorBrush x:Key="PanelBrush" Color="#F7F7F9FB" />
          <SolidColorBrush x:Key="PanelHeadBrush" Color="#F5E6EBF1" />
          <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFF" />
