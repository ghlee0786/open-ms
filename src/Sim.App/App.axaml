<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="using:Sim.App.Help"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Sim.App.App"
             RequestedThemeVariant="Dark">
  <!--
    디자인 토큰 — 화면은 이 키만 쓴다(하드코딩 색 금지 — 시험 ThemeTokenTests 가 소스를 훑는다).
    색: ThemeDictionaries 두 벌(Dark · Light, 같은 키셋 — 시험이 짝을 본다). 테마 전환 = Application.RequestedThemeVariant(ThemeService) → DynamicResource 가 다시 칠한다.
    팔레트: 참고(Ironwall Tactical Command) — 다크 primary 시안 #22B8D9 · 라이트 딥시안 #0C6B89 · 강조 앰버.
    글꼴 · 간격(4 · 8 · 12 · 16) · 모서리(4 · 6 · 10) · 그림자는 테마 불변 토큰(아래 공용) — 그림자 색만 테마별.
    해석 색(컬러맵 · 응력/압력/안전계수 척도 · 상태 색 · 물체 색)은 Rendering/ColorMaps · ColorScale 이 정하며 여기와 무관(표준 유지).
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- ==================== 다크 ==================== -->
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#22B8D9</Color>
          <Color x:Key="SystemAccentColorLight1">#3FCBE8</Color>
          <Color x:Key="SystemAccentColorLight2">#6FD9EF</Color>
          <Color x:Key="SystemAccentColorLight3">#9EE6F5</Color>
          <Color x:Key="SystemAccentColorDark1">#1A9AB8</Color>
          <Color x:Key="SystemAccentColorDark2">#147D96</Color>
          <Color x:Key="SystemAccentColorDark3">#0E5F73</Color>

          <!-- 표면 -->
          <SolidColorBrush x:Key="BgBrush" Color="#0C1117" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#141B23" />
          <SolidColorBrush x:Key="Surface2Brush" Color="#1B242F" />
          <SolidColorBrush x:Key="Surface3Brush" Color="#232E3A" />
          <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#0F151C" />
          <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2B3846" />
          <SolidColorBrush x:Key="SurfacePressedBrush" Color="#344454" />
          <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1F2935" />
          <!-- 선 -->
          <SolidColorBrush x:Key="LineBrush" Color="#26313D" />
          <SolidColorBrush x:Key="ControlBorderBrush" Color="#3A4859" />
          <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#5F7185" />
          <!-- 글자 -->
          <SolidColorBrush x:Key="TextBrush" Color="#E6EDF3" />
          <SolidColorBrush x:Key="TextDimBrush" Color="#A6B4C2" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#7F8E9E" />
          <SolidColorBrush x:Key="TextDisabledBrush" Color="#566372" />
          <!-- 주색 · 강조 -->
          <SolidColorBrush x:Key="AccentBrush" Color="#22B8D9" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#3FCBE8" />
          <SolidColorBrush x:Key="AccentPressedBrush" Color="#1A9AB8" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#5FD3EC" />
          <SolidColorBrush x:Key="OnAccentBrush" Color="#04161C" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A3A46" />
          <SolidColorBrush x:Key="HighlightBrush" Color="#F0A33C" />
          <SolidColorBrush x:Key="FocusRingBrush" Color="#3FCBE8" />
          <!-- 상태 -->
          <SolidColorBrush x:Key="OkBrush" Color="#46D17A" />
          <SolidColorBrush x:Key="WarnBrush" Color="#FFB02E" />
          <SolidColorBrush x:Key="ErrBrush" Color="#FF6B63" />
          <SolidColorBrush x:Key="InfoBrush" Color="#4FB8FF" />
          <SolidColorBrush x:Key="OkSoftBrush" Color="#1E3B2B" />
          <SolidColorBrush x:Key="WarnSoftBrush" Color="#3D3019" />
          <SolidColorBrush x:Key="ErrSoftBrush" Color="#3D1F21" />
          <!-- 상태 칩(물체 모드) · 배지 -->
          <SolidColorBrush x:Key="ChipBrush" Color="#263545" />
          <SolidColorBrush x:Key="ChipFreeBrush" Color="#16475A" />
          <SolidColorBrush x:Key="ChipLandedBrush" Color="#1F4D33" />
          <SolidColorBrush x:Key="ChipStowedBrush" Color="#323D4A" />
          <SolidColorBrush x:Key="ChipTextBrush" Color="#E6EDF3" />
          <SolidColorBrush x:Key="StateStowedBrush" Color="#8A94A3" />
          <SolidColorBrush x:Key="StateFreeBrush" Color="#4FB8FF" />
          <SolidColorBrush x:Key="StateLandedBrush" Color="#46D17A" />
          <SolidColorBrush x:Key="BadgeTrustedBrush" Color="#1BAF7A" />
          <SolidColorBrush x:Key="BadgeReferenceBrush" Color="#EDA100" />
          <SolidColorBrush x:Key="BadgeEstimateBrush" Color="#E34948" />
          <SolidColorBrush x:Key="BadgeTextBrush" Color="#0B0F14" />
          <!-- 3D 뷰 위 HUD · 떠 있는 막대 -->
          <SolidColorBrush x:Key="HudBrush" Color="#D90F151C" />
          <SolidColorBrush x:Key="HudTextBrush" Color="#D6DEE8" />
          <SolidColorBrush x:Key="ScrimBrush" Color="#B8040810" />
          <!-- 3D 위 브라우저(어셈블리) — 반투명 바탕 · 머리줄 · 들여쓰기 가이드 -->
          <SolidColorBrush x:Key="BrowserBgBrush" Color="#E0121820" />
          <SolidColorBrush x:Key="BrowserHeadBrush" Color="#F01A222C" />
          <SolidColorBrush x:Key="BrowserGuideBrush" Color="#33404E" />
          <SolidColorBrush x:Key="BrowserHoverBrush" Color="#9E2B3846" />
          <!-- 셸(참고 MetroWindow · HamburgerMenu · 이벤트 패널): 제목 표시줄 · 아이콘 레일 · 3D 위 반투명 패널 · 창 닫기 단추 -->
          <SolidColorBrush x:Key="TitleBarBrush" Color="#0E141B" />
          <SolidColorBrush x:Key="RailBrush" Color="#F20E141B" />
          <SolidColorBrush x:Key="PanelBrush" Color="#F5111820" />
          <SolidColorBrush x:Key="PanelHeadBrush" Color="#F2192430" />
          <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFF" />
          <!-- 그래프 -->
          <SolidColorBrush x:Key="PlotBgBrush" Color="#10161D" />
          <SolidColorBrush x:Key="PlotAxisBrush" Color="#4E5C6C" />
          <SolidColorBrush x:Key="PlotGridBrush" Color="#28A0AABE" />
          <SolidColorBrush x:Key="PlotTextBrush" Color="#8E9BAA" />
          <SolidColorBrush x:Key="PlotTitleBrush" Color="#C9D3DD" />
          <SolidColorBrush x:Key="PlotCursorBrush" Color="#F2F6FA" />
          <SolidColorBrush x:Key="PlotLabelBackBrush" Color="#C810161D" />
          <Color x:Key="PlotSeries1Color">#00BFFF</Color>
          <Color x:Key="PlotSeries2Color">#FFA500</Color>
          <Color x:Key="PlotSeries3Color">#FF6347</Color>
          <Color x:Key="PlotSeries4Color">#32CD32</Color>
          <Color x:Key="PlotSeries5Color">#6495ED</Color>
          <Color x:Key="PlotSeries6Color">#FFD700</Color>
          <Color x:Key="PlotSeries7Color">#EE82EE</Color>
          <!-- 레전드 패널(막대 색 = 데이터 — 바탕 · 글자만 테마) -->
          <SolidColorBrush x:Key="LegendBgBrush" Color="#E0141A22" />
          <SolidColorBrush x:Key="LegendTextBrush" Color="#D6DEE8" />
          <SolidColorBrush x:Key="LegendDimBrush" Color="#8A96A6" />
          <SolidColorBrush x:Key="LegendLineBrush" Color="#3A4552" />
          <!-- 3D 뷰(OpenGL) — ThemeService 가 Color 로 읽어 GlView 팔레트에 넘긴다 -->
          <Color x:Key="ViewBgColor">#12171F</Color>
          <Color x:Key="ViewGroundColor">#161B22</Color>
          <Color x:Key="ViewGridColor">#669A73</Color>
          <Color x:Key="ViewDividerColor">#333D4C</Color>
          <Color x:Key="ViewActiveColor">#22B8D9</Color>
          <Color x:Key="ViewMarkerColor">#FFFFFF</Color>
          <Color x:Key="ViewRiserColor">#D9D9D9</Color>
          <!-- 풍동 · 가상 풍동 무대(흐름 시각화 데이터 색 기준 — 두 테마 모두 어두운 무대) -->
          <SolidColorBrush x:Key="StageBgBrush" Color="#040406" />
          <SolidColorBrush x:Key="StageHudBrush" Color="#C80D1015" />
          <SolidColorBrush x:Key="StagePanelBrush" Color="#D8141A22" />
          <SolidColorBrush x:Key="StageLineBrush" Color="#3A4552" />
          <SolidColorBrush x:Key="StageTextBrush" Color="#E6ECF2" />
          <SolidColorBrush x:Key="StageDimBrush" Color="#9AA6B4" />
          <SolidColorBrush x:Key="StageWarnBrush" Color="#FFC857" />
          <SolidColorBrush x:Key="GradeBadgeBrush" Color="#E09A3A" />
          <SolidColorBrush x:Key="GradeBadgeTextBrush" Color="#0B0F14" />
          <!-- 그림자 -->
          <BoxShadows x:Key="ShadowSm">0 1 2 0 #40000000</BoxShadows>
          <BoxShadows x:Key="ShadowMd">0 4 14 0 #66000000</BoxShadows>
          <BoxShadows x:Key="ShadowLg">0 10 30 0 #80000000</BoxShadows>
          <SolidColorBrush x:Key="ShadowBrush" Color="#59000000" />

          <!-- Fluent 컨트롤 색을 토큰으로(템플릿이 DynamicResource 로 찾는 키) -->
          <SolidColorBrush x:Key="ButtonBackground" Color="#232E3A" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2B3846" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#344454" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0F151C" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#E6EDF3" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6EDF3" />
          <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#7F8E9E" />
          <!-- 참고 Console.Button: 테두리 1 · 꺼지면 테두리 투명 + 가라앉은 판(형태로 말함) -->
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3A4859" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#5F7185" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#5F7185" />
          <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#00000000" />
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="#232E3A" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2B3846" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#344454" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#22B8D9" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3FCBE8" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#1A9AB8" />
          <SolidColorBrush x:Key="ToggleButtonForeground" Color="#E6EDF3" />
          <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#04161C" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#04161C" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#04161C" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#0F151C" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#121A22" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0F151C" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3A4859" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#5F7185" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#22B8D9" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#E6EDF3" />
          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E6EDF3" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E6EDF3" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7F8E9E" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#0F151C" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#121A22" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#19222C" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3A4859" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#5F7185" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#22B8D9" />
          <SolidColorBrush x:Key="ComboBoxForeground" Color="#E6EDF3" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1B242F" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#3A4859" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#1B242F" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#3A4859" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#1B242F" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#3A4859" />
          <SolidColorBrush x:Key="ToolTipBackground" Color="#1F2935" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#E6EDF3" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#3A4859" />
          <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#3FCBE8" />
          <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#00000000" />
        </ResourceDictionary>

        <!-- ==================== 라이트 ==================== -->
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#0C6B89</Color>
          <Color x:Key="SystemAccentColorLight1">#1F84A4</Color>
          <Color x:Key="SystemAccentColorLight2">#4FA3BE</Color>
          <Color x:Key="SystemAccentColorLight3">#86C2D5</Color>
          <Color x:Key="SystemAccentColorDark1">#09556E</Color>
          <Color x:Key="SystemAccentColorDark2">#074457</Color>
          <Color x:Key="SystemAccentColorDark3">#053342</Color>

          <SolidColorBrush x:Key="BgBrush" Color="#DCE2EA" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F6F9" />
          <SolidColorBrush x:Key="Surface2Brush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Surface3Brush" Color="#E6EBF1" />
