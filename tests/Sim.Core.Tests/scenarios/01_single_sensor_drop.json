{
  "schema": "mns.scenario/1",
  "name": "01_single_sensor_drop",
  "description": "단일 물체 낙하: 150 m 정지 비행 드론에서 지상감시센서(스파이크 선행형) 투하. L1 형상 공력 + CP 후방(핀) + 회전 감쇠.",
  "sim": { "dt": 0.001, "tEnd": 120, "outputRate": 100, "seed": 1 },
  "environment": {
    "groundAltitude": 0,
    "temperatureOffset": 0,
    "wind": { "speed": 5, "directionFrom": 270, "refHeight": 10, "shear": "log", "roughness": 0.03 },
    "turbulence": "light",
    "soil": "farmland"
  },
  "carrier": { "name": "drone_hover", "altitude": 150, "speed": 0, "heading": 0,
    "shape": { "type": "box", "size": [0.35, 0.35, 0.12] } },
  "bodies": [
    {
      "name": "sensor",
      "parent": "drone_hover",
      "mount": [0, 0, 0.12],
      "mountAttitude": [0, 0, 0],
      "mass": 1.0,
      "cg": [0.04, 0, 0],
      "shape": { "type": "cylinder", "radius": 0.04, "length": 0.30, "axis": "x" },
      "aero": { "cp": [-0.07, 0, 0], "damping": [-2, -12, -12], "refLength": 0.30 },
      "noseCoefficient": 0.8,
      "color": "#e0a030"
    }
  ],
  "events": [
    { "name": "drop", "when": { "type": "time", "t": 0.5 }, "do": [ { "type": "separate", "body": "sensor", "relVel": [0, 0, 0.5] } ] }
  ],
  "dispersions": [
    { "path": "environment.wind.speed", "dist": "truncnormal", "sd": 1.5, "min": -5, "max": 6 },
    { "path": "environment.wind.directionFrom", "dist": "normal", "sd": 20 },
    { "path": "bodies.sensor.mass", "dist": "normal", "mode": "scale", "sd": 0.02 },
    { "path": "bodies.sensor.mountAttitude.1", "dist": "uniform", "min": -10, "max": 10 }
  ],
  "monteCarlo": { "runs": 200, "impactBody": "sensor", "sampling": "lhs", "seed": 11 },
  "gpuMonteCarlo": {
    "runs": 100000,
    "seed": 7,
    "sampling": "lhs",
    "model": {
      "mass": 1.0, "cdA": 0.0041, "dt": 0.005, "tMax": 120,
      "release": { "altitude": 150, "speed": 0, "heading": 0 }
    },
    "dispersions": [
      { "path": "environment.wind.speed", "dist": "truncnormal", "sd": 1.5, "min": -5, "max": 6 },
      { "path": "environment.wind.directionFrom", "dist": "normal", "sd": 20 },
      { "path": "model.cdA", "dist": "normal", "mode": "scale", "sd": 0.15 }
    ]
  }
}
