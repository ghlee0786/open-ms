  "events": [
    {
      "name": "container_release",
      "when": {
        "type": "time",
        "t": 0.5
      },
      "do": [
        {
          "type": "separate",
          "body": "container",
          "relVel": [
            0,
            0,
            2.0
          ]
        }
      ]
    },
    {
      "name": "lid_drogue",
      "when": {
        "type": "after",
        "event": "container.separated",
        "delay": 1.2
      },
      "do": [
        {
          "type": "separate",
          "body": "lid",
          "relVel": [
            -5,
            0,
            0
          ]
        },
        {
          "type": "deploy",
          "device": "container.drogue"
        }
      ]
    },
    {
      "name": "main_deploy",
      "when": {
        "type": "or",
        "any": [
          {
            "type": "and",
            "all": [
              {
                "type": "after",
                "event": "lid_drogue",
                "delay": 1.0
              },
              {
                "type": "speed",
                "body": "container",
                "below": 45
              }
            ]
          },
          {
            "type": "after",
            "event": "lid_drogue",
            "delay": 12.0
          }
        ]
      },
      "do": [
        {
          "type": "release",
          "device": "container.drogue"
        },
        {
          "type": "deploy",
          "device": "container.main"
        }
      ]
    },
    {
      "name": "eject1",
      "when": {
        "type": "altitude",
        "body": "container",
        "below": 800
      },
      "do": [
        {
          "type": "separate",
          "body": "box1",
          "relVel": [
            4,
            0,
            0
          ]
        }
